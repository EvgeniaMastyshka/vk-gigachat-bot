# ============================================================
#  Шаблон настроек. Скопируйте файл в .env и заполните значения.
#  Реальный .env НЕ коммитится в Git и не должен попадать в архив.
#  Никогда не вставляйте настоящие ключи в .env.example, README или код.
# ============================================================

# ===== GigaChat API =====
# Ключ авторизации (Authorization Key) из GigaChat Studio.
# Это готовая строка Base64(Client ID:Client Secret), БЕЗ префикса "Basic ".
# Где получить: developers.sber.ru/studio -> проект GigaChat API ->
#               Настройки API -> Получить ключ.
GIGACHAT_AUTH_KEY=

# Версия API по типу аккаунта:
#   GIGACHAT_API_PERS — физические лица;
#   GIGACHAT_API_B2B  — ИП/юрлица по платным пакетам;
#   GIGACHAT_API_CORP — ИП/юрлица по схеме pay-as-you-go.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель генерации. Например: GigaChat-2-Max, GigaChat-2-Pro, GigaChat-2-Lite.
GIGACHAT_MODEL=GigaChat-2-Max

# Адреса API. Обычно менять не нужно.
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Параметры генерации.
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_MAX_TOKENS=1024

# Таймаут одного HTTP-запроса к GigaChat, секунды.
GIGACHAT_TIMEOUT=60

# Проверка SSL-сертификата. Не отключайте в production.
GIGACHAT_VERIFY_SSL=true

# Необязательно: путь к дополнительному корневому сертификату
# (например, сертификатам Минцифры), если он не установлен в системе.
# Относительный путь считается от папки проекта.
# GIGACHAT_CA_BUNDLE=certs/russian_trusted_ca.pem

# ===== VK API =====
# Ключ доступа сообщества с правом «Сообщения сообщества» (messages).
# Где получить: Управление сообществом -> Дополнительно -> Работа с API ->
#               Ключи доступа -> Создать ключ.
VK_TOKEN=

# Числовой ID сообщества БЕЗ минуса. Например: 123456789 (не -123456789).
# Сообщество должно совпадать с тем, для которого выпущен VK_TOKEN.
VK_GROUP_ID=

# Версия VK API.
VK_API_VERSION=5.199

# ===== Работа бота =====
# Сколько диалогов обрабатывать параллельно.
BOT_WORKERS=4

# Сколько последних сообщений диалога отправлять в GigaChat.
MAX_HISTORY_MESSAGES=12

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
